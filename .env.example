# Copy to .env in the repository root. Supply your own local configuration.
# Existing operating-system environment variables take precedence.
# JAVA_HOME may be omitted if JDK 11 is already on PATH.
# MAVEN_HOME or M2_HOME may be used instead of adding Maven to PATH.
# JAVA_HOME=C:/Program Files/Java/jdk-11

DB_USER=nuanxun
DB_PASSWORD=
DB_JDBC_URL=jdbc:mysql://127.0.0.1:3306/web?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# URL-encode special characters in the Python database password.
VOLUNTEER_DB_URL=mysql+pymysql://nuanxun:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/web
DEMO_PASSWORD=

JAVA_INTERNAL_ORIGIN=http://127.0.0.1:8080
